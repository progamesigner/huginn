HUGINN_ENVIRONMENT=dev

# Required to answer a turn: every model an agent uses must be listed by some provider.
# adapter is openai or anthropic; base_url is optional, for an OpenAI-compatible gateway.
# HUGINN_PROVIDERS=[{"name":"openai","adapter":"openai","api_key":"sk-...","models":["gpt-5-mini"]}]

# Optional: referenced by huginn.yaml tool entries (value_from) and the
# websearch live smoke tests
# FELO_API_KEY=

# Optional: only needed to run the live LLM smoke tests with `pytest -m integration`
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
